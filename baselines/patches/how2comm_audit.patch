+def _compatible_pcd_to_np(path):
+    cloud = o3d.io.read_point_cloud(str(path))
+    xyz = np.asarray(cloud.points, dtype=np.float32)
+    colors = np.asarray(cloud.colors, dtype=np.float32)
+    intensity = (colors[:, :1] if colors.shape[0] == xyz.shape[0]
+                 else np.zeros((xyz.shape[0], 1), dtype=np.float32))
+    return np.hstack((xyz, intensity)).astype(np.float32, copy=False)
+
+
+pcd_utils.pcd_to_np = _compatible_pcd_to_np
